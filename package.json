{
  "name": "roomly-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/domain.test.mjs",
    "test:backend": "node --test tests/backend.test.mjs",
    "test:e2e": "npm run build && playwright test",
