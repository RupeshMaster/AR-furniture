    "assets:posters": "node scripts/generate-posters.mjs",
    "seed": "node scripts/seed-pocketbase.mjs",
    "format": "prettier --write src scripts tests backend/pb_hooks backend/pb_migrations *.js *.json *.html"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "pocketbase": "^0.28.1",
